generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model users {
  id                     String   @id @default(uuid())
  email                  String   @unique
  username               String?
  auth_provider          String   @default("email")
  google_id              String?
  email_verified         Boolean  @default(false)
  referral_code          String   @unique
  referred_by            String?
  signup_tokens_credited Boolean  @default(false)
  created_at             DateTime @default(now())
}

model user_tokens {
  id                 String @id @default(uuid())
  user_id            String @unique
  balance            Int    @default(0)
  lifetime_purchased Int    @default(0)
  lifetime_spent     Int    @default(0)
}

model token_bundles {
  id              String   @id @default(uuid())
  name            String
  tokens          Int
  base_price      Decimal  @db.Decimal(6,2)
  current_price   Decimal  @db.Decimal(6,2)
  stripe_price_id String
  is_most_popular Boolean  @default(false)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum ReferralStatus {
  PENDING
  CLAIMED
}

enum FeedbackStatus {
  OPEN
  IN_PROGRESS
  CLOSED
  DONE
}

model purchases {
  id                         String         @id @default(uuid())
  user_id                    String
  /// Set for Stripe Checkout; null when using PaymentIntent + PaymentElement only
  stripe_checkout_session_id String?
  stripe_payment_intent_id   String?
  bundle_id                  String
  tokens_purchased           Int
  amount_paid_cents          Int
  status                     PurchaseStatus @default(PENDING)
  created_at                 DateTime       @default(now())
  updated_at                 DateTime       @default(now()) @updatedAt
}

model referrals {
  id          String          @id @default(uuid())
  referrer_id String
  referred_id String          @unique
  status      ReferralStatus  @default(PENDING)
  created_at  DateTime        @default(now())
  claimed_at  DateTime?
  expires_at  DateTime
}

model judge_cache {
  id               String   @id @default(uuid())
  game_id          String
  /// Supabase `auth.users.id` when the judge request carried a valid session; null for guests.
  user_id          String?
  /// Normalized player guess (lowercased trim).
  input_text       String
  /// Canonical slot: `su_survey_answers.id` (pack) or custom `ss:qa:*`.
  survey_answer_id String
  matched_answer   String?
  /// True = semantic match for this triple; false = cached non-match. When every still-hidden id has `false`, the judge skips Anthropic.
  is_match         Boolean
  created_at       DateTime @default(now())

  @@unique([game_id, user_id, input_text, survey_answer_id])
}

model feedback {
  id         String         @id @default(uuid())
  user_id    String?
  game_id    String?
  category   String
  message    String
  status     FeedbackStatus @default(OPEN)
  notes      String         @default("")
  created_at DateTime       @default(now())
}

model game_sessions {
  id        String   @id @default(uuid())
  user_id   String
  game_id   String
  completed Boolean  @default(false)
  timestamp DateTime @default(now())
  metadata  Json?
}

model game_config {
  game_id         String   @id
  game_name       String
  tokens_per_game Int
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
}

model signup_verification_challenges {
  id         String   @id @default(uuid())
  user_id    String
  token_hash String   @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime @default(now())

  @@index([user_id])
}

model su_survey_packs {
  id          String                 @id @default(uuid())
  name        String
  description String
  is_free     Boolean                @default(false)
  is_active   Boolean                @default(true)
  created_at  DateTime               @default(now())
  questions   su_survey_questions[]
  tags        su_survey_pack_tags[]
}

model su_survey_pack_tags {
  id         String          @id @default(uuid())
  pack_id    String
  label      String
  color      String?
  expires_at DateTime?
  created_at DateTime        @default(now())
  pack       su_survey_packs @relation(fields: [pack_id], references: [id], onDelete: Cascade)

  @@index([pack_id])
}

model su_survey_questions {
  id            String           @id @default(uuid())
  pack_id       String
  question      String
  display_order Int
  created_at    DateTime         @default(now())
  pack          su_survey_packs   @relation(fields: [pack_id], references: [id], onDelete: Cascade)
  answers       su_survey_answers[]

  @@index([pack_id, display_order])
}

model su_survey_answers {
  id            String           @id @default(uuid())
  question_id   String
  answer        String
  points        Int
  display_order Int
  question      su_survey_questions @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@index([question_id, display_order])
}

model su_custom_surveys {
  id            String   @id @default(uuid())
  user_id       String
  name          String?
  collection_id String?
  question      String
  answers       Json
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model su_custom_survey_collections {
  id         String   @id @default(uuid())
  user_id    String
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model su_survey_showdown_sessions {
  id         String @id @default(uuid())
  session_id String @unique
  team1      String
  team2      String
  rounds     Int
  pack       String
  winner     String
  score1     Int
  score2     Int
}