STAGING_ENFORCE_ORIGIN=true
# comma-separated full origins except for FRONTEND_URL
ALLOWED_ORIGINS=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Anthropic
ANTHROPIC_API_KEY=

# Turnstile — must pair with frontend NEXT_PUBLIC_TURNSTILE_SITE_KEY (same widget).
# Test sitekeys emit tokens like *.DUMMY.TOKEN.* — only this test secret validates them:
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Production: use the secret shown in Cloudflare for your production widget (not the line above).
TURNSTILE_SECRET_KEY=

# App
PORT=3001
NODE_ENV=development
JWT_SECRET=
FRONTEND_URL=http://localhost:3000