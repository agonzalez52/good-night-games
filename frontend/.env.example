# frontend/.env.example
# Committed to git. All keys present, all values blank.
# Copy this to .env.local and fill in values for local development.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MOCK_MODE=
# AdSense display ads toggle (`true` enables real ad units + script)
NEXT_PUBLIC_ADSENSE_ENABLED=
# AdSense Publisher ID (`ca-pub-XXXXXXXXXXXXXXXX`)
NEXT_PUBLIC_ADSENSE_CLIENT=
# Set `true` for test creatives (`data-adtest="on"`) in non-production
NEXT_PUBLIC_ADSENSE_TEST_MODE=
# Setup screen ad unit slot ID
NEXT_PUBLIC_ADSENSE_SLOT_SETUP=
# Board between-round result panel slot ID
NEXT_PUBLIC_ADSENSE_SLOT_BOARD_ROUND=
# Board game-over panel slot ID
NEXT_PUBLIC_ADSENSE_SLOT_BOARD_GAMEOVER=
# Face-off screen slot ID
NEXT_PUBLIC_ADSENSE_SLOT_FACEOFF=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_BACKEND_URL=
STAGING_BASIC_USER=staging
STAGING_PASSWORD=
